{
  "name": "nh-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard monitoring the GTNewHorizons GitHub organization",
  "scripts": {
    "start": "npm run build && npm run serve",
    "build": "node --env-file-if-exists=.env src/build.js",
    "build:fresh": "node --env-file-if-exists=.env src/build.js --no-cache",
    "ingest": "node --env-file-if-exists=.env src/ingest.js --no-cache",
    "ingest:traffic": "node --env-file-if-exists=.env src/ingest/traffic.js",
    "verify:app": "node --env-file-if-exists=.env scripts/verify-app.js",
    "rebuild:ci": "node --env-file-if-exists=.env scripts/rebuild-ci-health.js",
    "rebuild:issues": "node --env-file-if-exists=.env scripts/rebuild-issues.js",
    "rebuild:drilldown": "node --env-file-if-exists=.env scripts/rebuild-drilldown.js",
    "serve": "node --env-file-if-exists=.env src/serve.js",
    "webhook:test": "node scripts/send-test-webhook.js",
    "backfill:commits": "node --env-file-if-exists=.env worker/backfill-commits.js",
    "backfill:labels": "node --env-file-if-exists=.env worker/backfill-labels.js",
    "backfill:prs": "node --env-file-if-exists=.env worker/backfill-prs.js",
    "backfill:runs": "node --env-file-if-exists=.env worker/backfill-runs.js",
    "test:exclusion": "node --experimental-sqlite --env-file-if-exists=.env test/exclusion.test.js",
    "test:handlers": "node --experimental-sqlite worker/test/handlers.test.js",
    "test:recompute": "node --experimental-sqlite worker/test/recompute.test.js",
    "test:parity": "npm run test:parity:contributors && npm run test:parity:analytics && npm run test:parity:issues && npm run test:parity:review-state && npm run test:parity:releases && npm run test:parity:by-label && npm run test:parity:ci-health && npm run test:parity:drilldown",
    "test:parity:ci-health": "node --experimental-sqlite worker/test/ci-health.parity.test.js",
    "test:parity:contributors": "node --experimental-sqlite worker/test/contributors.parity.test.js",
    "test:parity:analytics": "node --experimental-sqlite worker/test/analytics.parity.test.js",
    "test:parity:issues": "node --env-file-if-exists=.env --experimental-sqlite worker/test/issues.parity.test.js",
    "test:parity:drilldown": "node --env-file-if-exists=.env --experimental-sqlite --max-old-space-size=6144 worker/test/drilldown.parity.test.js",
    "test:parity:review-state": "node --experimental-sqlite worker/test/review-state.parity.test.js",
    "test:parity:releases": "node --experimental-sqlite worker/test/releases.parity.test.js",
    "test:parity:by-label": "node --experimental-sqlite worker/test/by-label.parity.test.js",
    "test:freshness": "node test/freshness.test.js",
    "test:drilldown-live": "node test/drilldown-live.test.js",
    "test:backfill-prs": "node --experimental-sqlite worker/test/backfill-prs.test.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
