# Copy to .env and fill in. .env is gitignored.
#
# Classic token with "public_repo" scope is enough for now.
# When this moves to the org and needs private repos, swap in a token with
# full "repo" scope — no code changes required.
GITHUB_TOKEN=ghp_your_token_here

# Org to monitor.
GITHUB_ORG=GTNewHorizons
